<form class="change-password-form" data-redirect="{{route "SETTINGS"}}" novalidate>
  <div class="change-password-form__fields">
    {{> Input variant="row" id="oldPassword" name="oldPassword" type="password" label="Старый пароль" autocomplete="current-password"}}
    {{> Input variant="row" id="newPassword" name="newPassword" type="password" label="Новый пароль" autocomplete="new-password"}}
    {{> Input variant="row" id="newPasswordRepeat" name="newPasswordRepeat" type="password" label="Повторите новый пароль" autocomplete="new-password"}}
  </div>
  {{> Button type="submit" text="Сохранить" className="change-password-form__submit"}}
</form>
