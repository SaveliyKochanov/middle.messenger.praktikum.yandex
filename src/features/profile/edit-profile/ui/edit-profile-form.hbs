<form class="edit-profile-form" novalidate>
  <div class="edit-profile-form__fields">
    {{{Input variant="row" id="email" name="email" type="email" label="Почта" value=user.email autocomplete="email"}}}
    {{{Input variant="row" id="login" name="login" label="Логин" value=user.login autocomplete="username"}}}
    {{{Input variant="row" id="first_name" name="first_name" label="Имя" value=user.first_name autocomplete="given-name"}}}
    {{{Input variant="row" id="second_name" name="second_name" label="Фамилия" value=user.second_name autocomplete="family-name"}}}
    {{{Input variant="row" id="display_name" name="display_name" label="Имя в чате" value=user.display_name autocomplete="nickname"}}}
    {{{Input variant="row" id="phone" name="phone" type="tel" label="Телефон" value=user.phone autocomplete="tel"}}}
  </div>
  {{{Button type="submit" text="Сохранить" className="edit-profile-form__submit"}}}
</form>
