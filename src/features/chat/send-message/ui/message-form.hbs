<form class="message-form" action="#">
  <input
    class="message-form__field"
    name="message"
    type="text"
    placeholder="Сообщение"
    autocomplete="off"
  >
  <button
    class="message-form__send"
    type="submit"
    aria-label="Отправить"
  >
    {{> IconArrow}}
  </button>
</form>
